# Copia este archivo a .env y completa los valores. NO subas .env a git.

# Conexión a la base de datos (MySQL)
DATABASE_URL="mysql://usuario:clave@localhost:3306/gym"

# Secreto para firmar las sesiones (JWT). OBLIGATORIO, mínimo 32 caracteres, aleatorio.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# (Opcional) Carpeta de imágenes subidas. En desarrollo se usa public/uploads.
# En producción (Docker) ya vale /data/uploads: monta un volumen persistente ahí.
# UPLOAD_DIR=
