generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  cedula           String   @unique
  name             String
  role             String   // admin, coach, athlete, cajero, recepcion
  password         String   // Contraseña principal (ahora requerida)
  accessPin        String?  // PIN / Código de Barras autogenerado para cajeros/recepción
  baseSalary       Float?   // Sueldo base individual para empleados
  commissionRate   Float?   // Comisión para coaches
  profilePicture   String?  @db.Text
  gender           String?  // M o F
  email            String?
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
// Relaciones
  memberships      Membership[]  @relation("AthleteMemberships")
  biometrics       Biometric[]
  transactions     Transaction[] @relation("CashierTransactions")
  customerTx       Transaction[] @relation("CustomerTransactions")
  attendances      Attendance[]
  payrollReceipts  PayrollReceipt[]
  cashSessions     CashSession[]
  
  coachedAthletes  User[]        @relation("CoachToAthlete")
  coach            User?         @relation("CoachToAthlete", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId          String?
  previousCoachId  String?

  // Configuración Laboral Extra
  paymentFrequency String?
  commissionType   String?
  birthDate        String?
  profession       String?
  specialties      String?
  nonWorkingDays   String?
  lastPaidDate     DateTime?
  bankAccount      String?
  mobilePayment    String?
}

model PayrollReceipt {
  id           String   @id @default(cuid())
  employeeId   String
  employee     User     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date         DateTime @default(now())
  periodStart  DateTime
  periodEnd    DateTime
  baseSalary   Float
  commission   Float
  bonus        Float    @default(0)
  deductions   Float    @default(0)
  advances     Float    @default(0)
  totalPaid    Float
  notes        String?  @db.Text
}

model CashSession {
  id                 String   @id @default(cuid())
  cashierId          String
  cashier            User     @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startTime          DateTime @default(now())
  endTime            DateTime?
  startingCash       Float    @default(0)
  declaredCash       Float?
  expectedCash       Float?
  expectedCard       Float?
  expectedTransfer   Float?
  status             String   @default("OPEN") // OPEN, CLOSED
  transactions       Transaction[]
}

model RecurringExpense {
  id            String   @id @default(cuid())
  description   String
  amount        Float
  category      String
  dayOfMonth    Int
  lastProcessed DateTime?
  isActive      Boolean  @default(true)
}

model Membership {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    User     @relation("AthleteMemberships", fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate  DateTime
  endDate    DateTime
  status     String   // ACTIVE, EXPIRED
  createdAt  DateTime @default(now())
}

model Biometric {
  id           String   @id @default(cuid())
  athleteId    String
  athlete      User     @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date         DateTime @default(now())
  weight       Float
  height       Float
  customFields String?  
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime @default(now())
  type      String   // IN, OUT
}

model Product {
  id          String   @id @default(cuid())
  barcode     String   @unique
  name        String
  price       Float
  cost        Float
  stock       Int
  category    String
  createdAt   DateTime @default(now())
}

model Transaction {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  cashierId     String
  cashier       User     @relation("CashierTransactions", fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId    String?
  customer      User?    @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtotal      Float
  tax           Float
  total         Float
  paymentMethod String
  reference     String?
  status        String
  items         TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId     String
  name          String
  price         Float
  qty           Int
  subtotal      Float
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  amount      Float
  category    String
}
